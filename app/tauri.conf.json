{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "peekaboard",
  "version": "0.1.0",
  "identifier": "com.intersebbtor.peekaboard",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "app"
    ],
    "category": "Utility"
  }
}
